# Application
APP_NAME="Rechnungsprogramm"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Berlin

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=rechnung_db
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=7200
SESSION_DRIVER=file

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Company Info (Default)
COMPANY_NAME="Ihre Firma GmbH"
COMPANY_STREET="Musterstraße 123"
COMPANY_ZIP=12345
COMPANY_CITY=Berlin
COMPANY_COUNTRY=Deutschland
COMPANY_PHONE="+49 30 12345678"
COMPANY_EMAIL=info@example.com
COMPANY_WEB=www.example.com
COMPANY_TAX_ID=DE123456789
COMPANY_VAT_ID=DE123456789
COMPANY_REGISTER=HRB 12345
COMPANY_BANK_NAME="Musterbank"
COMPANY_IBAN=DE89370400440532013000
COMPANY_BIC=COBADEFFXXX

# Shopify Integration (optional)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=

# PDF Settings
PDF_FONT=helvetica
PDF_FONT_SIZE=10

# Invoice Settings
INVOICE_PREFIX=RE
INVOICE_DIGITS=5
INVOICE_YEAR_SEPARATOR=true

# Tax Settings
DEFAULT_TAX_RATE=19
REDUCED_TAX_RATE=7

# Payment Settings
DEFAULT_PAYMENT_TERMS=14
DEFAULT_SKONTO_DAYS=7
DEFAULT_SKONTO_PERCENT=2
